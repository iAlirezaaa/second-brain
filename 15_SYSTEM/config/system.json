{
  "name": "HADES OS",
  "schema_version": "3.0.0",
  "locale": "fa-IR",
  "storage": "local_first",
  "status": "v3 skeleton, no live orchestration",
  "planes": {
    "human": "00..10 - read and edited by a person; canonical knowledge",
    "machine": "11..15 - agent-facing; only 11_CONTROL is versioned, 12/13/14 are disposable or quarantined"
  },
  "memory_planes": {
    "project": {
      "tracked_store": ["03_PROJECTS"],
      "disposable_store": [],
      "kind": "project",
      "reader_script": "15_SYSTEM/scripts/hades.py",
      "test": "tests/test_phase21_records_are_visible.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    },
    "repository": {
      "tracked_store": ["HANDOFF.md", "CHANGELOG.md", "MEMORY.md"],
      "disposable_store": [],
      "kind": null,
      "reader_doc": "AGENTS.md",
      "test": "tests/test_phase18_measured_docs.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    },
    "agent": {
      "tracked_store": ["11_CONTROL/agents"],
      "disposable_store": [".kb/ltm.sqlite"],
      "kind": "agent",
      "reader_script": "15_SYSTEM/scripts/hades.py",
      "test": "tests/test_phase17_control_plane.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    },
    "task": {
      "tracked_store": ["09_OPERATIONS/tasks"],
      "disposable_store": ["12_RUNTIME/agent_runs"],
      "kind": "task",
      "reader_script": "15_SYSTEM/scripts/runs.py",
      "test": "tests/test_phase22_harness_bridge.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    },
    "error": {
      "tracked_store": ["15_SYSTEM/memory/lessons.jsonl"],
      "disposable_store": [],
      "kind": null,
      "reader_script": "scripts/memory.py",
      "test": "tests/test_phase15_repo_memory.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    },
    "decision": {
      "tracked_store": ["02_WIKI/decisions", "09_OPERATIONS/decisions"],
      "disposable_store": [],
      "kind": "decision",
      "reader_script": "15_SYSTEM/scripts/hades.py",
      "test": "tests/test_phase22_amend_a_record.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    },
    "knowledge": {
      "tracked_store": ["02_WIKI", "skills"],
      "disposable_store": [".kb/kb.sqlite"],
      "kind": "wiki_note",
      "reader_script": "15_SYSTEM/scripts/hades.py",
      "test": "tests/test_retrieval_golden.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    },
    "conversation": {
      "tracked_store": ["15_SYSTEM/integrations/local-sources.md"],
      "disposable_store": [".brain-data"],
      "kind": null,
      "reader_script": "15_SYSTEM/scripts/sources.py",
      "test": "tests/test_sources.py",
      "map": "02_WIKI/reference_maps/eight-memory-planes.md"
    }
  },
  "zones": [
    { "dir": "00_START_HERE", "plane": "human" },
    { "dir": "01_INBOX", "plane": "human", "registry": false },
    { "dir": "02_WIKI", "plane": "human", "registry": false },
    { "dir": "03_PROJECTS", "plane": "human", "registry": true },
    { "dir": "04_INTELLIGENCE", "plane": "human", "registry": true },
    { "dir": "05_WORKS", "plane": "human", "registry": true },
    { "dir": "06_CHANNELS", "plane": "human", "registry": true },
    { "dir": "07_PRODUCTS", "plane": "human", "registry": true },
    { "dir": "08_LEARNING", "plane": "human", "registry": true },
    { "dir": "09_OPERATIONS", "plane": "human", "registry": true, "denied_for_default_context": true },
    { "dir": "10_ARCHIVE", "plane": "human", "readonly": true },
    { "dir": "11_CONTROL", "plane": "machine", "registry": true },
    { "dir": "12_RUNTIME", "plane": "machine", "registry": false, "denied_for_default_context": true, "gitignore_required": true },
    { "dir": "13_LAB", "plane": "machine", "registry": false, "denied_for_default_context": true, "gitignore_required": true },
    { "dir": "14_CANDIDATES", "plane": "machine", "registry": false, "denied_for_default_context": true, "gitignore_required": true, "tracked_exception": true },
    { "dir": "15_SYSTEM", "plane": "machine", "registry": false, "generated_denied": true }
  ],
  "kinds": [
    { "kind": "project", "prefix": "PRJ", "zone": "03_PROJECTS", "container": "active|incubating|paused|completed|archived", "layout": "folder", "manifest": "project.json" },
    { "kind": "organization", "prefix": "ORG", "zone": "04_INTELLIGENCE", "container": "organizations", "layout": "folder", "manifest": "organization.json" },
    { "kind": "model", "prefix": "MOD", "zone": "04_INTELLIGENCE", "container": "models", "layout": "folder", "manifest": "model.json" },
    { "kind": "model_version", "prefix": "VER", "zone": "04_INTELLIGENCE", "container": "models", "layout": "subfolder", "manifest": "version.json", "parent_kind": "model" },
    { "kind": "news", "prefix": "NWS", "zone": "04_INTELLIGENCE", "container": "news", "layout": "file", "manifest": "note.md" },
    { "kind": "benchmark", "prefix": "BMK", "zone": "04_INTELLIGENCE", "container": "benchmarks", "layout": "file", "manifest": "benchmark.json" },
    { "kind": "prompt", "prefix": "PRM", "zone": "05_WORKS", "container": "prompts", "layout": "folder", "manifest": "prompt.json" },
    { "kind": "workflow", "prefix": "WFL", "zone": "05_WORKS", "container": "workflows", "layout": "folder", "manifest": "workflow.json" },
    { "kind": "asset", "prefix": "AST", "zone": "05_WORKS", "container": "assets", "layout": "file", "manifest": "asset.json" },
    { "kind": "deliverable", "prefix": "DEL", "zone": "05_WORKS", "container": "deliverables", "layout": "file", "manifest": "deliverable.json" },
    { "kind": "channel", "prefix": "CHN", "zone": "06_CHANNELS", "container": "channels", "layout": "file", "manifest": "channel.json" },
    { "kind": "episode", "prefix": "EPI", "zone": "06_CHANNELS", "container": "episodes", "layout": "file", "manifest": "episode.json" },
    { "kind": "campaign", "prefix": "CMP", "zone": "06_CHANNELS", "container": "campaigns", "layout": "file", "manifest": "campaign.json" },
    { "kind": "app", "prefix": "APP", "zone": "07_PRODUCTS", "container": "apps|miniapps|games|extensions", "layout": "file", "manifest": "app.json" },
    { "kind": "tutorial", "prefix": "TUT", "zone": "08_LEARNING", "container": "tutorials|courses|learning_paths", "layout": "folder", "manifest": "tutorial.json" },
    { "kind": "task", "prefix": "TSK", "zone": "09_OPERATIONS", "container": "tasks", "layout": "file", "manifest": "task.json" },
    { "kind": "decision", "prefix": "DEC", "zone": "09_OPERATIONS", "container": "decisions", "layout": "file", "manifest": "decision.json" },
    { "kind": "wiki_note", "prefix": "WIK", "zone": "02_WIKI", "container": "concepts|decisions|glossary|playbooks|reference_maps", "layout": "file", "manifest": "note.md" },
    { "kind": "agent", "prefix": "AGT", "zone": "11_CONTROL", "container": "agents", "layout": "folder", "manifest": "agent.json" },
    { "kind": "subagent", "prefix": "SAG", "zone": "11_CONTROL", "container": "subagents", "layout": "folder", "manifest": "agent.json" },
    { "kind": "skill", "prefix": "SKL", "zone": "11_CONTROL", "container": "skills", "layout": "folder", "manifest": "skill.json" },
    { "kind": "mcp", "prefix": "MCP", "zone": "11_CONTROL", "container": "mcp", "layout": "file", "manifest": "mcp.json" },
    { "kind": "hook", "prefix": "HOK", "zone": "11_CONTROL", "container": "hooks", "layout": "file", "manifest": "hook.json" },
    { "kind": "command", "prefix": "CMD", "zone": "11_CONTROL", "container": "commands", "layout": "file", "manifest": "command.json" },
    { "kind": "mode", "prefix": "MDE", "zone": "11_CONTROL", "container": "modes", "layout": "file", "manifest": "mode.json" },
    { "kind": "loop", "prefix": "LOP", "zone": "11_CONTROL", "container": "loops", "layout": "file", "manifest": "loop.json" },
    { "kind": "schedule", "prefix": "SCH", "zone": "11_CONTROL", "container": "schedules", "layout": "file", "manifest": "schedule.json" },
    { "kind": "harness", "prefix": "HAR", "zone": "11_CONTROL", "container": "harnesses", "layout": "file", "manifest": "harness.json" },
    { "kind": "plugin", "prefix": "PLG", "zone": "11_CONTROL", "container": "plugins", "layout": "file", "manifest": "plugin.json" },
    { "kind": "template", "prefix": "TPL", "zone": "11_CONTROL", "container": "templates", "layout": "file", "manifest": "template.json" },
    { "kind": "policy", "prefix": "POL", "zone": "11_CONTROL", "container": "policies", "layout": "file", "manifest": "policy.json" },
    { "kind": "sandbox", "prefix": "SBX", "zone": "11_CONTROL", "container": "sandboxes", "layout": "file", "manifest": "sandbox.json" },
    { "kind": "experiment", "prefix": "EXP", "zone": "13_LAB", "container": "experiments|agents_in_training|models_in_training", "layout": "folder", "manifest": "experiment.json", "never_production": true },
    { "kind": "candidate", "prefix": "CAND", "zone": "14_CANDIDATES", "container": "agents|skills|outputs", "layout": "folder", "manifest": "candidate.json", "requires_evidence": true }
  ],
  "status_sets": {
    "project": ["incubating", "active", "paused", "completed", "archived"],
    "agent": ["draft", "tested", "approved", "production", "deprecated"],
    "subagent": ["draft", "tested", "approved", "production", "deprecated"],
    "skill": ["draft", "tested", "approved", "deprecated"],
    "model_version": ["rumored", "announced", "available", "deprecated"],
    "model": ["rumored", "announced", "available", "deprecated"],
    "organization": ["tracked", "verified", "stale"],
    "news": ["unverified", "verified", "superseded"],
    "prompt": ["draft", "tested", "approved", "deprecated"],
    "workflow": ["draft", "tested", "approved", "deprecated"],
    "tutorial": ["draft", "verified", "stale"],
    "candidate": ["proposed", "reviewed", "approved", "rejected"],
    "experiment": ["running", "evaluating", "passed", "failed", "archived"],
    "schedule": ["active", "paused", "retired"],
    "benchmark": ["unverified", "verified", "stale"],
    "asset": ["collected", "cleared", "retired"],
    "deliverable": ["draft", "reviewed", "published", "retired"],
    "channel": ["planned", "active", "paused", "retired"],
    "episode": ["draft", "produced", "published", "retired"],
    "campaign": ["planned", "running", "completed", "retired"],
    "app": ["prototype", "beta", "live", "retired"],
    "task": ["open", "blocked", "done", "cancelled"],
    "decision": ["proposed", "accepted", "rejected", "superseded"],
    "wiki_note": ["draft", "reviewed", "stable", "stale"],
    "mcp": ["draft", "configured", "verified", "disabled"],
    "hook": ["draft", "enabled", "disabled", "retired"],
    "command": ["draft", "active", "deprecated"],
    "mode": ["draft", "active", "retired"],
    "loop": ["proposed", "active", "paused", "retired"],
    "harness": ["planned", "connected", "verified", "retired"],
    "plugin": ["available", "installed", "disabled", "retired"],
    "template": ["draft", "in_use", "retired"],
    "policy": ["proposed", "enforced", "retired"],
    "sandbox": ["prepared", "running", "used", "destroyed"],
    "default": ["draft", "tested", "approved", "deprecated"]
  },
  "relations": {
    "parent_ids": "structural parent, multiple allowed",
    "depends_on": "blocking prerequisite",
    "integrates_with": "interface contract, not parenthood",
    "related_ids": "reference only",
    "variant_of": "personal or alternate version of the same thing",
    "derived_from": "lineage",
    "supersedes": "replaces a record; superseded leaves the active index",
    "uses_model_ids": "provenance: which model version produced this",
    "uses_prompt_ids": "provenance: which prompt version",
    "uses_workflow_ids": "provenance: which workflow version",
    "produced_by": "provenance: which agent/run",
    "approved_for_harness_ids": "harnesses this skill/agent is cleared for",
    "evidence_paths": "files on disk backing the claim"
  },
  "allowed_classifications": ["public", "internal", "confidential", "restricted"],
  "default_classification": "internal",
  "context_max_chars": 12000,
  "stale_after_days": 90,
  "gate_rules": {
    "promote_requires": ["evaluation.passed", "safety_review.passed", "human_approved", "evidence_paths_exist"],
    "sync_status_required": "approved",
    "publish_visibility_required": "PRIVATE",
    "publish_max_file_mb": 8,
    "publish_max_files": 1000
  },
  "feature_flags": {
    "vector_search": false,
    "live_orchestration": false,
    "external_ingestion": false,
    "filesystem_acl_enforcement": false,
    "automated_backup_scheduling": false,
    "github_autosync": false,
    "wiki_local_preview": true,
    "private_github_export": true,
    "plan_before_apply": true
  },
  "gitignore_required_paths": ["12_RUNTIME/", "13_LAB/", "14_CANDIDATES/", "15_SYSTEM/generated/", "15_SYSTEM/backups/"],
  "notes": [
    "kinds drive the CLI; adding a kind is config, not code",
    "11_CONTROL is the only machine-plane zone under version control",
    "statuses not listed for a kind fall back to default",
    "stale_after_days only applies to records carrying last_verified",
    "a gitignore_required machine zone may be absent from a clone by design; tracked_exception zones (14_CANDIDATES) are quarantined but partly versioned, so their absence is a defect"
  ]
}
